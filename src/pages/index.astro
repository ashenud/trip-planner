---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import DayTimeline from "../components/DayTimeline.astro";
import MapSection from "../components/MapSection.astro";
import MealsSection from "../components/MealsSection.astro";
import WeatherSection from "../components/WeatherSection.astro";
import RisksSection from "../components/RisksSection.astro";
import LocationsGallery from "../components/LocationsGallery.astro";
import Footer from "../components/Footer.astro";

import day1 from "../data/day1.json";
import day2 from "../data/day2.json";
import tripInfo from "../data/tripInfo.json";
---

<Layout title={`${tripInfo.title} — ${tripInfo.dates}`}>
  <Nav />
  <Hero />
  <DayTimeline id="day1" label={day1.label} items={day1.items} />
  <DayTimeline id="day2" label={day2.label} items={day2.items}>
    <div class="mt-8 rounded-xl border border-sunset-500/30 bg-sunset-400/10 p-4 sm:p-5">
      <h3 class="font-serif text-base font-semibold text-sunset-600">{day2.returnJourney.label}</h3>
      <p class="mt-1 text-sm font-medium text-teal-800">
        {day2.returnJourney.start} → {day2.returnJourney.end}
      </p>
      <p class="mt-1 text-sm text-teal-900/80">{day2.returnJourney.notes}</p>
    </div>
  </DayTimeline>
  <MapSection />
  <MealsSection />
  <WeatherSection />
  <RisksSection />
  <LocationsGallery />
  <Footer />
</Layout>
