---
export interface Props {
  meals: Array<{
    meal: string;
    zone: string;
    arrival: string;
    departure: string;
    duration: string;
    fitsRoute: string;
  }>;
}

const { meals } = Astro.props;
---

<section id="meals" class="bg-teal-900 px-4 py-14 text-sand-50 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-serif text-2xl font-bold sm:text-3xl">Meals</h2>
    <p class="mt-2 max-w-2xl text-sm text-sand-200">
      No specific restaurants are pinned down — only the geographic zone, timing, and duration for each meal.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {meals.map((meal) => (
        <div class="rounded-xl bg-white/10 p-5 backdrop-blur-sm">
          <h3 class="font-serif text-lg font-semibold text-sunset-400">{meal.meal}</h3>
          <p class="mt-2 text-sm text-sand-100">{meal.zone}</p>
          <p class="mt-3 text-sm font-medium text-sand-50">
            {meal.arrival} – {meal.departure}
          </p>
          <p class="text-xs text-sand-200">{meal.duration} allocated</p>
          <p class="mt-3 text-xs text-teal-200">{meal.fitsRoute}</p>
        </div>
      ))}
    </div>
  </div>
</section>
