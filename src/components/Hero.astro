---
import plans from "../data/plans/index.json";
import { withBase } from "../utils/paths";

export interface Props {
  tripInfo: {
    title: string;
    dates: string;
    subtitle: string;
    stats: Array<{ label: string; value: string }>;
  };
  planLabel: string;
  activeSlug: string;
}

const { tripInfo, planLabel, activeSlug } = Astro.props;
---

<section id="top" class="relative overflow-hidden bg-gradient-to-br from-teal-800 via-teal-700 to-sunset-600 px-4 py-16 text-sand-50 sm:px-6 sm:py-24">
  <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-32 -left-16 h-80 w-80 rounded-full bg-white/10 blur-2xl"></div>

  <div class="relative mx-auto max-w-4xl text-center">
    <details class="group relative inline-block text-left">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-sand-100 select-none hover:bg-white/25">
        {planLabel}
        <span class="text-[10px] transition-transform group-open:rotate-180">▾</span>
      </summary>
      <ul class="absolute left-1/2 z-50 mt-2 w-72 -translate-x-1/2 overflow-hidden rounded-xl border border-teal-800/10 bg-white text-left normal-case tracking-normal text-teal-900 shadow-lg">
        {plans.map((plan) => (
          <li>
            <a
              href={withBase(`/plans/${plan.slug}/`)}
              class:list={[
                "block px-4 py-3 text-sm hover:bg-sand-100",
                plan.slug === activeSlug ? "bg-sand-100 font-semibold text-teal-800" : "text-teal-700",
              ]}
            >
              <div>{plan.label}</div>
              <div class="mt-0.5 text-xs font-normal text-teal-600/80">{plan.description}</div>
            </a>
          </li>
        ))}
      </ul>
    </details>
    <p class="mt-3 text-sm font-semibold uppercase tracking-widest text-sand-200">
      {tripInfo.dates}
    </p>
    <h1 class="mt-3 font-serif text-4xl font-bold leading-tight sm:text-5xl md:text-6xl">
      {tripInfo.title}
    </h1>
    <p class="mt-4 text-base text-sand-100 sm:text-lg">
      {tripInfo.subtitle}
    </p>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {tripInfo.stats.map((stat) => (
        <div class="rounded-2xl bg-white/10 px-4 py-5 backdrop-blur-sm">
          <div class="font-serif text-2xl font-bold sm:text-3xl">{stat.value}</div>
          <div class="mt-1 text-xs uppercase tracking-wide text-sand-200 sm:text-sm">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
