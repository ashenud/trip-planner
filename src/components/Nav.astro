---
const links = [
  { href: "#day1", label: "Day 1" },
  { href: "#day2", label: "Day 2" },
  { href: "#map", label: "Route" },
  { href: "#meals", label: "Meals" },
  { href: "#weather", label: "Weather" },
  { href: "#risks", label: "Risks" },
  { href: "#locations", label: "Locations" },
];
---

<header class="sticky top-0 z-50 border-b border-teal-800/10 bg-sand-50/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="#top" class="font-serif text-lg font-semibold text-teal-800 whitespace-nowrap">
      Trinco Trip
    </a>

    <ul class="hidden gap-3 text-sm font-medium text-teal-700 sm:flex sm:gap-6">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded-full px-3 py-1.5 transition-colors hover:bg-teal-100 hover:text-teal-800"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-teal-700 hover:bg-teal-100 sm:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <ul
    id="nav-mobile-menu"
    class="hidden flex-col gap-1 border-t border-teal-800/10 bg-sand-50 px-4 py-3 text-sm font-medium text-teal-700 sm:hidden"
  >
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="block rounded-lg px-3 py-2 transition-colors hover:bg-teal-100 hover:text-teal-800"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  const closeMenu = () => {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  };

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove("hidden");
      menu?.classList.add("flex");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    }
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", closeMenu);
  });
</script>
